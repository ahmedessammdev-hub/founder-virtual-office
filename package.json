{
  "name": "virtual-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start-office.mjs",
    "desktop": "node scripts/start-desktop.mjs",
    "dev:server": "pnpm --filter @virtual-office/server dev",
    "dev:web": "pnpm --filter @virtual-office/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @virtual-office/server test && pnpm --filter @virtual-office/web test",
    "smoke:cli": "pnpm --filter @virtual-office/server smoke:cli"
  }
}
